page { background: var(--canvas); color:var(--ink); font-family:PingFang SC, Microsoft YaHei, sans-serif; font-size:28rpx; }
.page { padding:28rpx 32rpx 150rpx; box-sizing:border-box; }
.primary-button { height:88rpx; border-radius:12rpx; background:var(--brand); color:#fff; display:flex; align-items:center; justify-content:center; font-size:28rpx; font-weight:500; }
.primary-button.disabled { opacity:.45; }
.secondary-button { height:88rpx; border:1rpx solid var(--line); border-radius:12rpx; background:#fff; color:var(--ink); display:flex; align-items:center; justify-content:center; }
.text-button { color:var(--brand); font-size:26rpx; }
.muted { color:var(--ink-secondary); }
.bottom-bar { position:fixed; z-index:10; left:0; right:0; bottom:0; padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background:#fff; border-top:1rpx solid var(--line); box-shadow:0 0 20rpx rgba(0,0,0,.05); }
.empty { text-align:center; padding:100rpx 24rpx; color:var(--ink-secondary); line-height:1.6; }
