.profile{padding-bottom:180rpx}.account-card{margin-top:12rpx;background:#fff;border-radius:24rpx;padding:32rpx 24rpx;display:flex;align-items:center;box-shadow:0 8rpx 28rpx rgba(40,89,67,.06)}.avatar{width:112rpx;height:112rpx;border-radius:56rpx;background:#E8F0EA;color:#285943;display:flex;align-items:center;justify-content:center;font-family:Cambria Math,serif;font-size:70rpx;font-weight:600}.account-main{flex:1;min-width:0;margin-left:22rpx}.account-name{font-size:36rpx;font-weight:600}.account-id{color:#8A8A86;font-size:22rpx;margin-top:12rpx}.count-card{min-width:128rpx;text-align:center;color:#6E6E6A;font-size:22rpx}.count{font-size:48rpx;line-height:1.1;color:#285943;font-weight:600;margin-bottom:8rpx}.settings{margin-top:42rpx;background:#fff;border-radius:20rpx;overflow:hidden}.setting{height:108rpx;padding:0 22rpx;display:flex;align-items:center;border-bottom:1rpx solid #E7E7E2;font-size:29rpx}.setting:last-child{border-bottom:0}.setting-icon{width:60rpx;color:#285943;font-size:38rpx;text-align:center;margin-right:16rpx}.setting-note{margin-left:auto;color:#8A8A86;font-size:23rpx}.arrow{font-size:42rpx;line-height:1;color:#9AA09A;margin-left:14rpx}
