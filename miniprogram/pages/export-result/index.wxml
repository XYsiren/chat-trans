<view class="page result"><view wx:if="{{state==='generating'}}" class="waiting"><view class="spinner">○</view><view class="result-title">正在整理文档…</view><view class="muted">{{message}}</view></view><view wx:elif="{{state==='success'}}" class="waiting"><view class="success">✓</view><view class="result-title">文档已生成</view><view class="filename">{{name}}</view><view class="muted">公式会以可读文本形式保留，请在 Word 中核对。</view><view class="primary-button action" bindtap="download">下载到本地</view><view class="text-button" bindtap="edit">返回编辑</view></view><view wx:else class="waiting"><view class="failed">!</view><view class="result-title">暂时无法生成文档</view><view class="muted">{{message}}</view><view class="primary-button action" bindtap="retry">重新生成</view><view class="text-button" bindtap="edit">返回编辑</view></view></view>
