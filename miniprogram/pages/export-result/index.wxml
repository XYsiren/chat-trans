<view class="page result"><view wx:if="{{state==='generating'}}" class="waiting"><view class="spinner">○</view><view class="result-title">正在整理文档…</view><view class="muted">{{message}}</view></view><view wx:elif="{{state==='success'}}" class="waiting"><view class="success">✓</view><view class="result-title">文档已生成</view><view class="filename">{{name}}</view><view class="muted">{{formulaMode==='compatible'?'已使用手机兼容公式格式，微信预览可正常显示。':'已将可解析的 LaTeX 转为 Word 可编辑公式；标红内容请返回核对。'}}</view><view class="primary-button action" bindtap="download">下载到本地</view><view class="text-button" bindtap="edit">返回编辑</view></view><view wx:else class="waiting"><view class="failed">!</view><view class="result-title">暂时无法生成文档</view><view class="muted">{{message}}</view><view class="primary-button action" bindtap="retry">重新生成</view><view class="text-button" bindtap="edit">返回编辑</view></view></view>
