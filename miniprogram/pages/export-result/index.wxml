<view class="page result"><view wx:if="{{state==='generating'}}" class="waiting"><view class="spinner">○</view><view class="result-title">正在整理文档…</view><view class="muted">{{message}}</view></view><view wx:elif="{{state==='success'}}" class="waiting"><view class="success">✓</view><view class="result-title">文档已生成</view><view class="filename">{{name}}</view><view class="muted">{{formulaMode==='compatible'?'已使用微信预览兼容公式格式，可在手机和电脑端正常显示。':'已将可解析的 LaTeX 转为 Word 可编辑公式；请在 Word/WPS 中查看。'}}</view><view class="primary-button action" bindtap="download">分享 / 导出 Word</view><view class="text-button" bindtap="edit">返回编辑</view></view><view wx:else class="waiting"><view class="failed">!</view><view class="result-title">暂时无法生成文档</view><view class="muted">{{message}}</view><view class="primary-button action" bindtap="retry">重新生成</view><view class="text-button" bindtap="edit">返回编辑</view></view></view>
