<view wx:if="{{draft}}" class="page">
	<input class="title" value="{{draft.title}}" bindinput="title" maxlength="50" />

	<view class="subline">
		<text>最后保存于 本地</text>
		<text>
			{{draft.templateId === 'lab-report' ? '实验报告' : draft.templateId === 'study-note' ? '学术笔记' : '课程作业'}}
		</text>
	</view>

	<view class="tabs">
		<view class="tab {{tab==='edit'?'active':''}}" data-tab="edit" bindtap="switch">编辑</view>
		<view class="tab {{tab==='preview'?'active':''}}" data-tab="preview" bindtap="switch">预览</view>
		<text class="save" bindtap="save">保存</text>
	</view>

	<view wx:if="{{tab==='edit'}}">
		<view class="format">支持标题、列表、代码和 LaTeX 公式</view>
		<textarea class="editor" value="{{draft.sourceText}}" bindinput="input" placeholder="在这里粘贴或输入内容…" maxlength="{{max}}" />
		<view class="count">{{draft.sourceText.length}} / {{max}}</view>
		<view class="edit-actions">
			<text bindtap="example">载入示例</text>
			<text class="danger" bindtap="clear">清空</text>
		</view>
	</view>

	<view wx:else>
		<view wx:if="{{lastRepair}}" class="repair-tip">已应用一项修复 <text bindtap="undoRepair">撤销</text></view>
		<view wx:if="{{draft.blocks.length}}" class="summary" bindtap="issues">
			{{errors + warnings ? '！发现 ' + errors + ' 个需要处理的问题，' + warnings + ' 个提醒' : '✓ 内容检查完成'}}
			<text>查看</text>
		</view>
		<view wx:if="{{draft.blocks.length}}" class="paper">
			<document-block wx:for="{{draft.blocks}}" wx:key="id" block="{{item}}" active="{{activeBlockId===item.id}}" issue-count="{{0}}" bind:tap="focus" />
		</view>
		<view wx:else class="empty">完成识别后，会在这里展示文档预览。</view>
	</view>
</view>

<view class="bottom-bar">
	<view wx:if="{{tab==='edit'}}" class="primary-button" bindtap="parse">{{sourceDirty || !draft.blocks.length ? '识别内容结构' : '重新识别'}}</view>
	<view wx:else class="actions">
		<text class="secondary-check" bindtap="issues">检查内容</text>
		<view class="primary-button {{sourceDirty?'disabled':''}}" bindtap="next">选择版式</view>
	</view>
</view>

<view wx:if="{{panel}}" class="mask" bindtap="close">
	<view class="drawer" catchtap="noop">
		<view class="handle"></view>
		<view class="drawer-title">内容检查 <text bindtap="close">关闭</text></view>
		<view class="drawer-sub">{{errors}} 个需要处理 · {{warnings}} 个提醒 · {{score}} 分</view>
		<issue-card wx:for="{{visibleIssues}}" wx:key="id" issue="{{item}}" bind:focus="focusIssue" bind:accept="accept" bind:reject="reject" />
		<view wx:if="{{!visibleIssues.length}}" class="empty">暂未发现需要处理的问题</view>
	</view>
</view>
