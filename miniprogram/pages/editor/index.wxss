.title{font-size:40rpx;font-weight:600;background:transparent;height:66rpx}.subline{display:flex;justify-content:space-between;color:#6E6E6A;font-size:24rpx;margin:8rpx 0 30rpx}.tabs{display:flex;gap:48rpx;border-bottom:1rpx solid #E7E7E2;margin-bottom:24rpx}.tab{padding:16rpx 0;font-size:29rpx}.tab.active{font-weight:600;border-bottom:4rpx solid #285943}.save{margin-left:auto;color:#285943;padding-top:16rpx}.format,.count{font-size:24rpx;color:#6E6E6A}.editor{width:100%;height:720rpx;background:#fff;border:1rpx solid #E7E7E2;border-radius:12rpx;margin-top:15rpx;padding:24rpx;box-sizing:border-box;font-size:28rpx;line-height:1.65}.count{text-align:right;margin-top:10rpx}.edit-actions{display:flex;gap:32rpx;margin-top:22rpx;color:#285943;font-size:26rpx}.danger{color:#B64035}.summary{font-size:25rpx;background:#FFF4DF;color:#805e20;padding:18rpx 20rpx;display:flex;justify-content:space-between;margin-bottom:18rpx}.paper{background:#fff;padding:40rpx;border:1rpx solid #E7E7E2;border-radius:12rpx}.actions{display:flex;align-items:center;gap:28rpx}.actions .primary-button{flex:1}.secondary-check{color:#285943;white-space:nowrap}.mask{position:fixed;z-index:20;inset:0;background:rgba(0,0,0,.35)}.drawer{position:absolute;bottom:0;left:0;right:0;max-height:75vh;overflow:auto;background:#fff;padding:18rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));border-radius:24rpx 24rpx 0 0}.handle{width:70rpx;height:6rpx;background:#ddd;margin:0 auto 20rpx}.drawer-title{font-size:34rpx;font-weight:600;display:flex;justify-content:space-between}.drawer-title text{font-size:25rpx;font-weight:400;color:#6E6E6A}.drawer-sub{font-size:24rpx;color:#6E6E6A;margin:10rpx 0}
