page {
  background: linear-gradient(180deg, #f4f7fb 0%, #ffffff 28%, #ffffff 100%);
  font-family: PingFang SC;
}

.page-shell {
  padding: 28rpx 28rpx 60rpx;
}

.hero-card {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #fff;
  border-radius: 28rpx;
  padding: 34rpx 28rpx 30rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.18);
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #cbd5e1;
  font-size: 22rpx;
  margin-bottom: 18rpx;
}

.hero-title {
  font-size: 42rpx;
  line-height: 60rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 42rpx;
  color: #cbd5e1;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.primary-btn,
.secondary-btn,
.tool-btn {
  min-width: 160rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.primary-btn,
.tool-btn.primary {
  background: #111827;
  color: #fff;
}

.secondary-btn,
.tool-btn {
  background: #fff;
  color: #111827;
  border: 2rpx solid rgba(17, 24, 39, 0.12);
}

.tab-bar {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(17, 24, 39, 0.08);
  color: rgba(17, 24, 39, 0.7);
  font-size: 26rpx;
}

.tab-item-active {
  background: #111827;
  color: #fff;
  border-color: #111827;
}

.section-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 22rpx;
}

.content-input {
  width: 100%;
  min-height: 520rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #111827;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.preview-toolbar {
  margin-top: 0;
  margin-bottom: 20rpx;
}

.hint-box {
  margin-top: 20rpx;
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 20rpx;
}

.hint-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.hint-text {
  font-size: 25rpx;
  line-height: 40rpx;
  color: rgba(17, 24, 39, 0.7);
}

.doc-preview {
  background: #fbfcfe;
  border-radius: 24rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(17, 24, 39, 0.06);
}

.preview-block {
  margin-bottom: 18rpx;
}

.paragraph-block,
.quote-block {
  font-size: 28rpx;
  line-height: 46rpx;
  color: rgba(15, 23, 42, 0.9);
}

.quote-block {
  padding: 18rpx 20rpx;
  background: #f8fafc;
  border-left: 6rpx solid #111827;
  border-radius: 16rpx;
}

.inline-code {
  display: inline;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: rgba(17, 24, 39, 0.08);
  color: #111827;
  font-size: 90%;
}

.inline-strong {
  display: inline;
  font-weight: 700;
}

.inline-em {
  display: inline;
  font-style: italic;
}

.empty-state {
  background: #f8fafc;
  color: rgba(17, 24, 39, 0.65);
  padding: 60rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 26rpx;
}

.result-card {
  border-radius: 24rpx;
  padding: 24rpx;
}

.success-card {
  background: linear-gradient(135deg, #effdf4 0%, #f8fff9 100%);
}

.error-card {
  background: linear-gradient(135deg, #fff5f5 0%, #fffafa 100%);
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.result-line {
  font-size: 26rpx;
  line-height: 42rpx;
  color: rgba(17, 24, 39, 0.75);
}

.result-toolbar {
  margin-top: 20rpx;
}

.draft-tip {
  text-align: center;
  font-size: 24rpx;
  color: rgba(17, 24, 39, 0.55);
  padding: 10rpx 0 0;
}