<view wx:if="{{draft}}" class="page"><view class="lead">根据用途设置文档的排版方式</view><view class="templates"><template-card wx:for="{{templates}}" wx:key="id" template="{{item}}" selected="{{item.id===draft.templateId}}" bind:choose="choose"/></view><view class="option-title">导出选项</view><label class="check"><checkbox checked="{{cover}}" bindchange="cover" color="#285943"/> 添加封面</label><label class="check"><checkbox checked="{{formulaNumbers}}" bindchange="number" color="#285943"/> 显示公式编号</label></view><view class="bottom-bar"><view wx:if="{{errors}}" class="risk">仍有 {{errors}} 个问题未处理，导出后请自行核对。<text bindtap="back">返回检查</text></view><view class="primary-button" bindtap="generate">生成 Word 文档</view></view>
