<view class="page history"><view class="lead">查看已导出的文档，或从常用版式开始创建。</view><view class="section-title">常用版式</view><view class="templates"><view wx:for="{{templates}}" wx:key="id" class="template" bindtap="create" data-id="{{item.id}}"><view class="template-name">{{item.name}}</view><view class="template-desc">{{item.description}}</view><text>›</text></view></view><view class="section-title">导出历史</view><view wx:if="{{exports.length}}" class="history-list"><view wx:for="{{exports}}" wx:key="id" class="history-item" bindtap="open" data-id="{{item.id}}"><view><view class="history-title">{{item.title || '未命名文档'}}</view><view class="history-meta">{{item.templateId==='lab-report'?'实验报告':item.templateId==='study-note'?'学术笔记':'课程作业'}} · 已导出</view></view><text>›</text></view></view><view wx:else class="empty">还没有已导出的文档。</view></view><bottom-nav active="history" />
