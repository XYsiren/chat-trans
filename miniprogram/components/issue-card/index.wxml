<view class="card {{issue.severity}}" bindtap="focus">
	<view class="top">
		<text>{{issue.severity === 'error' ? '需要处理' : '提醒'}}</text>
		<text class="category">{{issue.category}}</text>
	</view>
	<view class="message">{{issue.message}}</view>
	<view wx:if="{{issue.suggestion}}" class="compare">
		<view>原内容 {{issue.suggestion.before}}</view>
		<view>建议 {{issue.suggestion.after}}</view>
	</view>
	<view class="actions">
		<view class="ignore" catchtap="reject">忽略</view>
		<view wx:if="{{issue.suggestion}}" class="accept" catchtap="accept">采用</view>
	</view>
</view>
