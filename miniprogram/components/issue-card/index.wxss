.card{padding:22rpx 0;border-bottom:1rpx solid #E7E7E2}.top{display:flex;justify-content:space-between;font-size:23rpx}.category{color:#B35E00}.error .top{color:#B64035}.warning .top{color:#A76716}.message{font-size:28rpx;margin:12rpx 0}.compare{font-family:Consolas,monospace;font-size:23rpx;background:#F2F3F0;padding:14rpx;line-height:1.7}.actions{display:flex;justify-content:flex-end;gap:36rpx;margin-top:16rpx}.ignore,.accept{min-width:96rpx;text-align:center;padding:8rpx 16rpx;border-radius:999rpx}.ignore{color:#6E6E6A;background:#F3F3F1}.accept{color:#285943;font-weight:500;background:#EAF4EE}
