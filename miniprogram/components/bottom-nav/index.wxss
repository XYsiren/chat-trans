.nav-safe{position:fixed;z-index:30;left:0;right:0;bottom:0;padding:0 32rpx calc(18rpx + env(safe-area-inset-bottom));background:linear-gradient(transparent,#F5F5F2 28rpx)}.bottom-nav{height:112rpx;background:#fff;border-radius:56rpx;display:flex;align-items:center;justify-content:space-around;box-shadow:0 8rpx 30rpx rgba(40,89,67,.13)}.nav-item{width:33.33%;text-align:center;font-size:22rpx;color:#939993;line-height:1.25}.nav-icon{font-family:Arial,sans-serif;font-size:45rpx;height:52rpx;line-height:48rpx;font-weight:300}.nav-item.selected{color:#285943;font-weight:600}
