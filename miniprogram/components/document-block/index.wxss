.block{margin-bottom:26rpx;line-height:1.8;color:#242424;white-space:pre-wrap}.block.active{background:#FFF8E8;border-radius:14rpx;padding:8rpx 12rpx}.heading{font-weight:600;line-height:1.4;margin-top:12rpx}.h1{font-size:38rpx}.h2{font-size:34rpx}.h3{font-size:30rpx}.paragraph,.list,.quote{font-size:30rpx}.quote{border-left:4rpx solid #8ca292;padding-left:22rpx;color:#555}.code{background:#F2F3F0;padding:16rpx 20rpx 20rpx;border-radius:8rpx;font-family:Consolas,monospace;font-size:25rpx;overflow:auto;line-height:1.6}.code-label{font-family:PingFang SC;color:#6E6E6A;font-size:21rpx;margin-bottom:10rpx}.formula{text-align:center;padding:24rpx 8rpx;font-family:Cambria Math,STIX Two Math,serif;position:relative;overflow-x:auto}.formula-text{font-family:Cambria Math,STIX Two Math,serif;font-size:28rpx;line-height:2;white-space:pre-wrap;letter-spacing:.5rpx}.formula-fallback{display:block;margin-top:8rpx;color:#A76716;font-family:PingFang SC;font-size:22rpx}.issue-dot{font-family:PingFang SC;color:#A76716;font-size:20rpx;margin-left:12rpx}.table-wrap{overflow:auto;border:1rpx solid #D9DDD8;border-radius:8rpx;font-size:25rpx;white-space:normal}.table-row{display:flex;min-width:max-content;border-bottom:1rpx solid #D9DDD8}.table-row:last-child{border-bottom:0}.table-head{background:#EDF3EE;font-weight:600}.table-cell{box-sizing:border-box;min-width:180rpx;max-width:400rpx;padding:14rpx 16rpx;border-right:1rpx solid #D9DDD8;line-height:1.5;word-break:break-word}.table-cell:last-child{border-right:0}
